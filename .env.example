# --- Database ---
# Cấu hình kết nối Database PostgreSQL (Async)
DATABASE_URL=
# --- Security & JWT ---
# Khóa bí mật dùng để ký JWT (Access Token & Refresh Token)
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Khóa HMAC cho OTP
OTP_SECRET_KEY=

# --- Chống Brute-force & Khóa tài khoản ---
MAX_FAILED_LOGIN_ATTEMPTS=
ACCOUNT_LOCK_MINUTES=

# --- Tài khoản Admin Mặc định & Profile (Seed lúc khởi động) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_FULL_NAME=

# --- SMTP (Gửi email OTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Cloudinary (Lưu trữ ảnh) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
CORS_ORIGINS=
